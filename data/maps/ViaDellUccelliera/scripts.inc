ViaDellUccelliera_MapScripts::
	.byte 0

ViaDellUccelliera_EventScript_Sign::
	msgbox ViaDellUccelliera_Text_Sign, MSGBOX_SIGN
	end

ViaDellUccelliera_Text_Sign:
	.string "VIA DELL'UCCELLIERA\n"
	.string "La via delle fraschette$"

ViaDellUccelliera_EventScript_Padre::
	msgbox ViaDellUccelliera_Text_Padre, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Padre:
	.string "Ogni domenica cerchiamo un posto\n"
	.string "diverso dove mangiare.\p"
	.string "Ma alla fine i ragazzi vogliono\n"
	.string "sempre tornare qui!$"

ViaDellUccelliera_EventScript_Madre::
	msgbox ViaDellUccelliera_Text_Madre, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Madre:
	.string "Un pranzo in famiglia, un po' d'aria\n"
	.string "buona...\p"
	.string "A volte non serve altro per passare\n"
	.string "una bella giornata!$"

ViaDellUccelliera_EventScript_Bambino::
	msgbox ViaDellUccelliera_Text_Bambino, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Bambino:
	.string "Papà dice che devo lasciare spazio\n"
	.string "per il dolce!\p"
	.string "Ma io voglio un altro pezzo di pizza\n"
	.string "bianca!$"

ViaDellUccelliera_EventScript_Appassionato::
	msgbox ViaDellUccelliera_Text_Appassionato, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Appassionato:
	.string "C'è chi discute di Pokémon e chi\n"
	.string "discute di cucina.\p"
	.string "Io una cosa la so: la carbonara con\n"
	.string "la panna non si può sentire!$"

ViaDellUccelliera_EventScript_Amico::
	msgbox ViaDellUccelliera_Text_Amico, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Amico:
	.string "L'ultima volta ha discusso mezz'ora\n"
	.string "con lo chef sulla carbonara!\p"
	.string "Poi ne ha ordinate due!$"

ViaDellUccelliera_EventScript_Cameriere::
	msgbox ViaDellUccelliera_Text_Cameriere, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Cameriere:
	.string "Due carbonare, tre panini e un\n"
	.string "tagliere!\p"
	.string "Qui non ci si ferma un secondo...\p"
	.string "Ma sentire i clienti soddisfatti\n"
	.string "ripaga tutta la fatica!$"

ViaDellUccelliera_EventScript_Anziano::
	msgbox ViaDellUccelliera_Text_Anziano, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Anziano:
	.string "Da ragazzo venivo qui con mio padre.\p"
	.string "Le facce sono cambiate, ma il profumo\n"
	.string "della cucina è sempre lo stesso!$"

ViaDellUccelliera_EventScript_Ragazzo::
	msgbox ViaDellUccelliera_Text_Ragazzo, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Ragazzo:
	.string "Avevamo organizzato una passeggiata\n"
	.string "nei boschi...\p"
	.string "Siamo arrivati fin qui e ci siamo\n"
	.string "fermati a mangiare!$"

ViaDellUccelliera_EventScript_AmicaGruppo::
	msgbox ViaDellUccelliera_Text_AmicaGruppo, MSGBOX_NPC
	end

ViaDellUccelliera_Text_AmicaGruppo:
	.string "La prossima volta scegliamo prima dove\n"
	.string "mangiare.\p"
	.string "Con voi ogni passeggiata finisce\n"
	.string "davanti a un piatto di pasta!$"

ViaDellUccelliera_EventScript_ClienteBuongustaio::
	msgbox ViaDellUccelliera_Text_ClienteBuongustaio, MSGBOX_NPC
	end

ViaDellUccelliera_Text_ClienteBuongustaio:
	.string "Sono venuto per un panino con la\n"
	.string "porchetta.\p"
	.string "Poi ho visto il menù... e ho deciso\n"
	.string "di fermarmi per pranzo!$"

ViaDellUccelliera_EventScript_Compagna::
	msgbox ViaDellUccelliera_Text_Compagna, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Compagna:
	.string "Dice sempre che vuole mangiare poco...\p"
	.string "Ma quando siamo alle fraschette\n"
	.string "ordina per tre persone!$"

ViaDellUccelliera_EventScript_Escursionista::
	msgbox ViaDellUccelliera_Text_Escursionista, MSGBOX_NPC
	end

ViaDellUccelliera_Text_Escursionista:
	.string "Questi boschi nascondono sentieri\n"
	.string "bellissimi.\p"
	.string "Ma fai attenzione: allontanarsi dalla\n"
	.string "strada senza conoscere la zona non è\n"
	.string "una buona idea!$"
