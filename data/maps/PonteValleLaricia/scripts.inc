	msgbox PonteValleLaricia_Text_ContadinoCasale1, MSGBOX_NPC
	end

PonteValleLaricia_EventScript_ContadinaCasale2::
	msgbox PonteValleLaricia_Text_ContadinaCasale2, MSGBOX_NPC
	end

PonteValleLaricia_EventScript_AbitanteCasetta::
	msgbox PonteValleLaricia_Text_AbitanteCasetta, MSGBOX_NPC
	end

PonteValleLaricia_EventScript_AnzianoValle::
